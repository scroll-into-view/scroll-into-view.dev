---
import computePkg from 'compute-scroll-into-view/package.json'
import scrollPkg from 'scroll-into-view-if-needed/package.json'
import smoothPkg from 'smooth-scroll-into-view-if-needed/package.json'
---

<footer class="footer">
  <div class="container">
    <div class="content has-text-centered">
      <p>
        <a href="https://github.com/stipsan/scroll-into-view-if-needed">
          GitHub
        </a>
      </p>
      <div class="field is-grouped is-grouped-centered is-grouped-multiline">
        <a
          href="https://www.npmjs.com/package/scroll-into-view-if-needed"
          class="control"
        >
          <div class="tags has-addons">
            <span class="tag is-dark">scroll-into-view-if-needed</span>
            <span class="tag is-info">{scrollPkg.version}</span>
          </div>
        </a>
        <a
          href="https://www.npmjs.com/package/smooth-scroll-into-view-if-needed"
          class="control"
        >
          <div class="tags has-addons">
            <span class="tag is-dark">
              smooth-scroll-into-view-if-needed
            </span>
            <span class="tag is-info">{smoothPkg.version}</span>
          </div>
        </a>
        <a
          href="https://www.npmjs.com/package/compute-scroll-into-view"
          class="control"
        >
          <div class="tags has-addons">
            <span class="tag is-dark">compute-scroll-into-view</span>
            <span class="tag is-info">{computePkg.version}</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 20px;
    text-align: center;
  }

  /* Bulma's default info blue is too light for white text (WCAG AA) */
  .tag.is-info {
    background-color: #2577b9;
  }
</style>
